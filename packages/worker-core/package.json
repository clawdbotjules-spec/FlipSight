{
  "name": "@flipsight/worker-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared worker framework: BullMQ bootstrap, schedulers, token-bucket rate limiting, robots.txt guard, polite HTTP client, dead-letter queue, health server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flipsight/db": "*",
    "@flipsight/shared": "*",
    "bullmq": "^6.0.9",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
