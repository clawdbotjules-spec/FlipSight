# ==============================================================================
# FlipSight environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# docker-compose reads this file for variable substitution. The values below
# default to a local dev setup (services on localhost). Inside containers,
# docker-compose overrides DATABASE_URL / REDIS_URL to point at the service
# hostnames automatically — you do not need to change them for `docker compose up`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core infrastructure
# ------------------------------------------------------------------------------

# PostgreSQL connection string (Prisma). Host-side tools (migrations, seeds)
# use this value; the api container derives its own from POSTGRES_* below.
DATABASE_URL=postgresql://flipsight:flipsight@localhost:5432/flipsight

# Redis connection string — used for BullMQ queues, hot cache, and pub/sub.
REDIS_URL=redis://localhost:6379

# Secret used to sign JWT access tokens. Generate a strong one:
#   openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string

# Public URL of the web frontend (used for CORS allow-list and links in alerts).
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Marketplace / data source credentials (used by workers in later phases)
# ------------------------------------------------------------------------------

# eBay developer keys (https://developer.ebay.com) — Browse API for live
# listings, Marketplace Insights / sold comps for valuations.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Keepa API key (https://keepa.com/#!api) — Amazon price history & rank data.
KEEPA_API_KEY=

# ------------------------------------------------------------------------------
# AI
# ------------------------------------------------------------------------------

# Anthropic API key (https://console.anthropic.com) — used for listing drafting,
# item classification from photos/descriptions, and estate-sale text parsing.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Alert delivery channels
# ------------------------------------------------------------------------------

# Discord webhook URL for the `discord` alert channel.
DISCORD_WEBHOOK_URL=

# Pushover credentials for the `pushover` alert channel (https://pushover.net).
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ------------------------------------------------------------------------------
# Local overrides (optional — sensible defaults are baked into docker-compose)
# ------------------------------------------------------------------------------

# Postgres bootstrap credentials used by the postgres container. If you change
# these, update DATABASE_URL above to match.
#POSTGRES_USER=flipsight
#POSTGRES_PASSWORD=flipsight
#POSTGRES_DB=flipsight

# Port the API listens on.
#PORT=4000

# Fastify log level: fatal | error | warn | info | debug | trace
#LOG_LEVEL=info

# Password given to the seeded demo user (dev only).
#SEED_DEMO_PASSWORD=flipsight-demo
