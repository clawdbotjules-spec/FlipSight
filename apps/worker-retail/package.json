{
  "name": "@flipsight/worker-retail",
  "version": "0.1.0",
  "private": true,
  "description": "Retailer clearance monitor (Walmart, Target) with a one-file-per-retailer plugin system and per-store inventory checks near a home ZIP.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@flipsight/db": "*",
    "@flipsight/shared": "*",
    "@flipsight/worker-core": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.23.11",
    "@types/node": "^26.2.0"
  }
}
