// FlipSight core data model.
//
// Multi-tenant from day one: every User belongs to an Org. Items/Valuations/
// Deals are global (the marketplace firehose is shared); per-user state lives
// in AlertRule, Deal.userId (who claimed it), AlertEvent, and FlipLedger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  admin
  member
}

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  alertRules    AlertRule[]
  claimedDeals  Deal[]
  ledgerEntries FlipLedger[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Sources & items
// ---------------------------------------------------------------------------

enum SourceKey {
  ebay
  keepa_amazon
  shopgoodwill
  walmart_clearance
  target_clearance
  estatesales
}

model Source {
  id        String    @id @default(cuid())
  key       SourceKey @unique
  name      String
  enabled   Boolean   @default(true)
  /// Per-source worker config: poll intervals, rate limits, category filters…
  config    Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items Item[]
}

/// Canonical product record as observed on a source.
model Item {
  id            String   @id @default(cuid())
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// The listing/product id on the source platform; unique per source.
  externalId    String
  title         String
  upc           String?
  isbn          String?
  asin          String?
  category      String?
  condition     String?
  imageUrls     String[] @default([])
  sourceUrl     String
  currentPrice  Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  /// Set for local-pickup items (estate sales, FB-alternative local listings).
  location      String?
  firstSeenAt   DateTime @default(now())
  lastCheckedAt DateTime @default(now())
  /// Raw source payload for reprocessing/debugging.
  raw           Json     @default("{}")

  valuations Valuation[]
  deals      Deal[]

  @@unique([sourceId, externalId])
  @@index([category])
  @@index([lastCheckedAt])
}

// ---------------------------------------------------------------------------
// Valuations & deals
// ---------------------------------------------------------------------------

enum CompSource {
  ebay_sold
  keepa
}

model Valuation {
  id              String     @id @default(cuid())
  itemId          String
  item            Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  estimatedResale Decimal    @db.Decimal(12, 2)
  resaleLow       Decimal    @db.Decimal(12, 2)
  resaleHigh      Decimal    @db.Decimal(12, 2)
  soldCompsCount  Int        @default(0)
  /// 0..1 — fraction of active listings that convert to sales.
  sellThroughRate Float?
  compSource      CompSource
  computedAt      DateTime   @default(now())

  deals Deal[]

  @@index([itemId, computedAt])
}

enum DealStatus {
  new
  alerted
  claimed
  dismissed
  purchased
  sold
}

model Deal {
  id          String     @id @default(cuid())
  itemId      String
  item        Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  valuationId String
  valuation   Valuation  @relation(fields: [valuationId], references: [id], onDelete: Restrict)
  buyPrice    Decimal    @db.Decimal(12, 2)
  estFees     Decimal    @db.Decimal(12, 2)
  estShipping Decimal    @db.Decimal(12, 2)
  netProfit   Decimal    @db.Decimal(12, 2)
  /// Return on investment as a percentage (netProfit / buyPrice * 100).
  roiPct      Float
  /// Composite attractiveness score, 0–100.
  score       Int
  status      DealStatus @default(new)
  /// Who claimed the deal; null while unclaimed.
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  alertEvents AlertEvent[]
  ledgerEntry FlipLedger?

  @@index([status, score])
  @@index([createdAt, id])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Alerting
// ---------------------------------------------------------------------------

enum AlertChannel {
  websocket
  discord
  pushover
}

model AlertRule {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String         @default("Untitled rule")
  minProfit       Decimal?       @db.Decimal(12, 2)
  /// Minimum ROI percent (50 = 50%).
  minRoi          Float?
  maxBuyPrice     Decimal?       @db.Decimal(12, 2)
  categories      String[]       @default([])
  keywords        String[]       @default([])
  excludeKeywords String[]       @default([])
  localOnly       Boolean        @default(false)
  channels        AlertChannel[] @default([websocket])
  enabled         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  alertEvents AlertEvent[]

  @@index([userId])
}

model AlertEvent {
  id          String       @id @default(cuid())
  dealId      String
  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        AlertRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel     AlertChannel
  sentAt      DateTime     @default(now())
  deliveredAt DateTime?

  @@unique([dealId, ruleId, channel])
  @@index([ruleId])
}

// ---------------------------------------------------------------------------
// P&L
// ---------------------------------------------------------------------------

/// One row per actual purchase — powers the P&L dashboard.
model FlipLedger {
  id             String    @id @default(cuid())
  dealId         String    @unique
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Restrict)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasePrice  Decimal   @db.Decimal(12, 2)
  purchasedAt    DateTime  @default(now())
  salePrice      Decimal?  @db.Decimal(12, 2)
  fees           Decimal?  @db.Decimal(12, 2)
  shipping       Decimal?  @db.Decimal(12, 2)
  soldAt         DateTime?
  realizedProfit Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, soldAt])
}
