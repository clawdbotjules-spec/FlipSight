{
  "name": "@flipsight/worker-goodwill",
  "version": "0.1.0",
  "private": true,
  "description": "ShopGoodwill worker: polite polling of public auction listings (robots-aware, 1 req / 2-3s, response caching) for configured categories.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@flipsight/db": "*",
    "@flipsight/shared": "*",
    "@flipsight/worker-core": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.23.11",
    "@types/node": "^26.2.0"
  }
}
